# =============================================================================
# Plantilla de Configuración de Variables de Entorno — ScoutingInteligente
# =============================================================================
# Copia este archivo como .env y edita sus valores con tus credenciales reales.
# =============================================================================

# ── Proveedores de LLM y APIs ────────────────────────────────────────────────
# Proveedor activo para la ejecución de agentes ("openai" | "groq")
LLM_PROVIDER=openai

# Clave de API de OpenAI (necesaria si LLM_PROVIDER=openai o para el juez de promptfoo)
OPENAI_API_KEY=sk-proj-tu_clave_de_openai_aqui

# Clave de API de Groq (necesaria si LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui

# ── Interfaz de Mensajería ───────────────────────────────────────────────────
# Token del bot de Telegram obtenido mediante BotFather
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui

# ── Configuración de Modelos ─────────────────────────────────────────────────
# Modelo de OpenAI a utilizar por el supervisor y agentes
OPENAI_MODEL_SUPERVISOR=gpt-4o-mini

# Modelo de Groq a utilizar por el supervisor y agentes
GROQ_MODEL_SUPERVISOR=llama-3.3-70b-versatile

# ── ETL y APIs Externas ──────────────────────────────────────────────────────
# Token temporal obtenido de la petición de cabecera 'x-mas' de FotMob.
# Requerido para la descarga y actualización de las estadísticas de FotMob.
X_MAS_TOKEN=tu_x_mas_token_temporal_aqui

# ── Directorios y Gráficos (Rutas del Contenedor) ────────────────────────────
# Ruta donde se almacenarán y buscarán los índices FAISS
INDICES_DIR=/data_local/processed/indices

# Ruta al ejecutable de Chrome para la generación de radares PNG
KAL_CHROME_PATH=/usr/bin/google-chrome-stable

# Directorio de caché de modelos HuggingFace para optimizar re-arranques
HF_HOME=/models_cache
TRANSFORMERS_CACHE=/models_cache
